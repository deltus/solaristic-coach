{
  "name": "solaristic-coach",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js .",
    "format": "node tools/lint/node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node tools/lint/node_modules/prettier/bin/prettier.cjs --check .",
    "lint:install": "npm ci --prefix tools/lint",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "dexie": "^4.4.6",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.4"
  }
}
